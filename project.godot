; Godot 4.6 — shared illustrated assets and authoritative rules.
config_version=5

[application]
config/name="Destan Diyarları"
run/main_scene="res://native/main.tscn"
config/features=PackedStringArray("4.6", "GL Compatibility")
config/icon="res://oyun/icon.svg"

[display]
window/size/viewport_width=1280
window/size/viewport_height=900
window/size/window_width_override=1280
window/size/window_height_override=900
window/size/resizable=true
window/dpi/allow_hidpi=true
window/stretch/mode="canvas_items"

[rendering]
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/default_filters/use_nearest_mipmap_filter=false
environment/defaults/default_clear_color=Color(0.035, 0.055, 0.065, 1)
